---
import Base from '../layouts/Base.astro';
import { textes } from '../lib/textes';
const T = (await textes()).page404;
---
<Base title={`${T.titre} · Océane Bourdenet`} description={T.texte}>
  <div class="wrap">
    <header class="page-head">
      <h1>{T.titre}</h1>
      <p>{T.texte}</p>
    </header>
    <p style="padding-bottom: 96px; display: flex; gap: 16px; flex-wrap: wrap;">
      <a class="btn" href="/">Retour à l'accueil</a>
      <a class="btn btn--ghost" href="/publications/">Voir les publications</a>
    </p>
  </div>
</Base>
