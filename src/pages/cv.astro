---
// CV complet, généré entièrement à partir de src/data/cv.yaml (brief 6).
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { periode, slug } from '../lib/format';
import { libelleCompetence } from '../config/competences';
import { publications, toutesCompetences } from '../lib/publications';

const cv = (await getEntry('cv', 'cv'))!.data;
const pubs = await publications();
const nbPreuves = (cle?: string) => (cle ? pubs.filter((p) => toutesCompetences(p).includes(cle)).length : 0);
const nbMedia = (media: string) => pubs.filter((p) => slug(p.data.media) === slug(media)).length;
const pluriel = (n: number) => `${n} publication${n > 1 ? 's' : ''}`;

// Savoir-être : calculés à partir des fiches, triés par nombre de publications
const savoirEtre = new Map<string, number>();
pubs.forEach((p) => p.data.competences.humaines.forEach((k) => savoirEtre.set(k, (savoirEtre.get(k) ?? 0) + 1)));
const NIVEAUX = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
---
<Base title={`CV · ${cv.profil.nom}`} description={`CV de ${cv.profil.nom}, ${cv.profil.titre.toLowerCase()} : expériences, formations, compétences et langues.`} page="cv">
  <div class="wrap">
    <header class="cv-head">
      <div>
        <h1>{cv.profil.nom}</h1>
        <p class="title">{cv.profil.titre} · {cv.profil.ville}</p>
        <p class="resume">{cv.profil.resume}</p>
        <p class="contacts">
          <a href="/#contact">Me contacter</a>
          {cv.profil.reseaux.map((r) => <a href={r.url} target="_blank" rel="noopener noreferrer">{r.nom} ↗</a>)}
        </p>
      </div>
    </header>

    <section class="cv-section" aria-labelledby="t-exp">
      <h2 id="t-exp">Expériences</h2>
      <ul class="entries">
        {cv.experiences.map((x) => {
          const n = nbMedia(x.media);
          return (
            <li class="entry">
              <span class="entry-date">{periode(x.debut, x.fin)}</span>
              <div>
                {x.logo && <div class="entry-logos"><Image src={x.logo} alt="" height={34} /></div>}
                <h3 class:list={{ sr: !!x.logo }}>{x.media}</h3>
                <p class="role">{x.poste} <span>· {x.type} · {x.lieu}</span></p>
                {x.description && <p class="desc">{x.description}</p>}
                {(n > 0 || x.pageAuteur) && (
                  <p class="entry-liens">
                    {n > 0 && <a class="more" href={`/publications/?media=${slug(x.media)}`}>Voir mes publications pour {x.media} ({n})</a>}
                    {x.pageAuteur && <a class="more" href={x.pageAuteur} target="_blank" rel="noopener noreferrer">Voir mes articles sur {x.media} ↗</a>}
                  </p>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="t-comp">
      <h2 id="t-comp">Compétences</h2>
      <div>
        <ul class="sk-phares">
          {cv.competences.phares.map((c) => {
            const n = nbPreuves(c.cle);
            return (
              <li>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
                <p class="exemple">Exemple : <a href={c.exemple.url} target="_blank" rel="noopener noreferrer">{c.exemple.titre} ↗</a></p>
                {n > 0 && <a class="more" href={`/publications/?competence=${c.cle}`}>{n > 1 ? `Voir les ${n} publications` : 'Voir la publication'}</a>}
              </li>
            );
          })}
        </ul>
        <p class="sk-intro">Rangées selon ma façon de travailler, de l'idée à la publication. Le chiffre renvoie aux publications où je les ai utilisées.</p>
        <div class="skill-groups">
          {cv.competences.groupes.map((g, i) => (
            <div class="sk-groupe">
              <h3><span>{String(i + 1).padStart(2, '0')}</span>{g.groupe}</h3>
              <ul>
                {g.items.map((it) => {
                  const n = nbPreuves(it.cle);
                  return <li><span>{it.nom}</span>{n > 0 && <a class="preuve" href={`/publications/?competence=${it.cle}`}>{pluriel(n)}</a>}</li>;
                })}
              </ul>
              {g.materiel && (
                <>
                  <p class="materiel-titre">Matériel</p>
                  <ul class="materiel">{g.materiel.map((m) => <li>{m}</li>)}</ul>
                </>
              )}
            </div>
          ))}
        </div>
        <div class="soft">
          <h3>Savoir-être</h3>
          <p>Calculés à partir des fiches de publication. Cliquer pour voir les publications concernées.</p>
          <ul>
            {[...savoirEtre.entries()].sort((a, b) => b[1] - a[1]).map(([k, n]) => (
              <li><a href={`/publications/?competence=${k}`}>{libelleCompetence(k)} <span>{n}</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="t-form">
      <h2 id="t-form">Formations</h2>
      <ul class="entries">
        {cv.formations.map((x) => (
          <li class="entry">
            <span class="entry-date">{periode(x.debut, x.fin)}</span>
            <div>
              {x.logos && <div class="entry-logos">{x.logos.map((l) => <Image src={l} alt="" height={34} />)}</div>}
              <h3>{x.diplome}</h3>
              <p class="role"><span>{x.etablissement}</span></p>
              {x.description && <p class="desc">{x.description}</p>}
              {x.echange && (
                <div class="sub-entry">
                  <span class="entry-date">{periode(x.echange.debut, x.echange.fin)}</span>
                  <div>
                    {x.echange.logos && <div class="entry-logos">{x.echange.logos.map((l) => <Image src={l} alt="" height={30} />)}</div>}
                    <h4>{x.echange.titre}</h4>
                    <p class="role"><span>{x.echange.etablissement}</span></p>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="t-lang">
      <h2 id="t-lang">Langues</h2>
      <ul class="langs">
        {cv.langues.map((l) => (
          <li>
            <span>{l.langue}</span>
            <span class="meter" aria-hidden="true">{NIVEAUX.map((_, j) => <i class:list={{ on: j <= NIVEAUX.indexOf(l.niveau) }}></i>)}</span>
            <b>{l.niveau}</b>
          </li>
        ))}
      </ul>
    </section>

    {cv.distinctions.length > 0 && (
      <section class="cv-section" aria-labelledby="t-dist">
        <h2 id="t-dist">Distinctions</h2>
        <ul class="entries">
          {cv.distinctions.map((x) => <li class="entry"><span class="entry-date">{x.annee}</span><div><h3>{x.titre}</h3>{x.description && <p class="desc">{x.description}</p>}</div></li>)}
        </ul>
      </section>
    )}

    <section class="cv-section" aria-labelledby="t-eng">
      <h2 id="t-eng">Engagement</h2>
      <ul class="entries">
        {cv.engagement.map((x) => (
          <li class="entry">
            <span class="entry-date">{periode(x.debut, x.fin)}</span>
            <div>
              <div class="entry-logos">{x.logo ? <Image class="carre" src={x.logo} alt="" height={56} /> : <span class="mono" aria-hidden="true">{x.structure[0]}</span>}</div>
              <h3>{x.structure}</h3>
              <p class="role">{x.role}</p>
              {x.description && <p class="desc">{x.description}</p>}
              {x.missions && <ul class="missions">{x.missions.map((m) => <li>{m}</li>)}</ul>}
              {x.lien && <a class="more ext" href={x.lien.url} target="_blank" rel="noopener noreferrer">{x.lien.libelle} ↗</a>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
