---
// Mentions légales (obligatoires en France, brief 10). Textes dans src/data/textes.yaml.
import Base from '../layouts/Base.astro';
import { textes } from '../lib/textes';
const sections = (await textes()).mentionsLegales;
---
<Base title="Mentions légales · Océane Bourdenet" description="Mentions légales du site d'Océane Bourdenet.">
  <div class="wrap">
    <header class="page-head"><h1>Mentions légales</h1></header>
    <div class="prose-legal">
      {sections.map((s) => (<><h2>{s.titre}</h2><p>{s.texte}</p></>))}
    </div>
  </div>
</Base>
