---
// Mise en page commune : métadonnées, polices locales, navigation, pied de page.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { image } from '../lib/images';

interface Props {
  title: string;
  description: string;
  page?: 'accueil' | 'publications' | 'cv' | 'autre';
}
const { title, description, page = 'autre' } = Astro.props;
const cv = (await getEntry('cv', 'cv'))!.data;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image(cv.profil.photo)!, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpeg' });
const ogUrl = new URL(ogImage.src, Astro.site).href;
// Données structurées Person (brief 8)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.profil.nom,
  jobTitle: cv.profil.titre,
  url: Astro.site?.href,
  image: ogUrl,
  sameAs: cv.profil.reseaux.map((r) => r.url),
  worksFor: cv.experiences.filter((x) => x.logo).map((x) => ({ '@type': 'Organization', name: x.media })),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="nav">
      <div class="wrap">
        <a class="nav-name" href="/">{cv.profil.nom}</a>
        <nav aria-label="Navigation principale">
          <ul>
            <li><a href="/" aria-current={page === 'accueil' ? 'page' : undefined}>Accueil</a></li>
            <li><a href="/publications/" aria-current={page === 'publications' ? 'page' : undefined}>Publications</a></li>
            <li><a href="/cv/" aria-current={page === 'cv' ? 'page' : undefined}>CV</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {cv.profil.nom}</span>
        <ul>
          {cv.profil.reseaux.map((r) => <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.nom}</a></li>)}
          <li><a href="/mentions-legales/">Mentions légales</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
